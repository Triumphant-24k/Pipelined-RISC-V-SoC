# Tolerances for the devices extracted parameters
#  tolerance(device_class_name, parameter_name [, :absolute => absolute_tolerance] [, :relative => relative_tolerance])
tolerance("PMOS_VTL", "W", :absolute => 1.nm, :relative => 0.001)
tolerance("PMOS_VTL", "L", :absolute => 1.nm, :relative => 0.001)
tolerance("PMOS_VTG", "W", :absolute => 1.nm, :relative => 0.001)
tolerance("PMOS_VTG", "L", :absolute => 1.nm, :relative => 0.001)
