#max_res(1000000)
#min_caps(1e-15)

max_branch_complexity(65536)
max_depth(16)


result = compare
if result
  result = lvs_data.flag_missing_ports(schematic.top_circuit)
end
puts(result ? "LVS_RESULT PASS" : "LVS_RESULT FAIL")
# An exit code alone is insufficient; upstream compare can fail without an exception.
File.write($status, result ? "PASS\n" : "FAIL\n")

endstream
