connect_implicit("XOR2_X2" , "VSS")

# Actually performs the extraction
netlist
# Canonicalize only the aliases introduced by the explicit well/body rules.
netlist.each_circuit do |c|
  c.each_net do |n|
    aliases = n.name.split(',')
    n.name = 'VDD' if aliases.include?('VDD') && (aliases - ['NWELL','VDD']).empty?
    n.name = 'VSS' if aliases.include?('VSS') && (aliases - ['BULK','PWELL','VSS']).empty?
    n.name = n.name.upcase # SPICE uses case-insensitive identifiers
  end
end

# Flatten cells which are present in one netlist only
align
# SIMPLIFICATION of the netlist
#netlist.make_top_level_pins
#netlist.combine_devices
#netlist.purge
#netlist.purge_nets
netlist.simplify

# Tolerances for the devices extracted parameters
#  tolerance(device_class_name, parameter_name [, :absolute => absolute_tolerance] [, :relative => relative_tolerance])
tolerance("PMOS_VTL", "W", :absolute => 1.nm, :relative => 0.001)
