tolerance("NMOS_VTL", "W", :absolute => 1.nm, :relative => 0.001)
tolerance("NMOS_VTL", "L", :absolute => 1.nm, :relative => 0.001)
tolerance("NMOS_VTG", "W", :absolute => 1.nm, :relative => 0.001)
tolerance("NMOS_VTG", "L", :absolute => 1.nm, :relative => 0.001)
tolerance("NMOS_VTH", "W", :absolute => 1.nm, :relative => 0.001)
tolerance("NMOS_VTH", "L", :absolute => 1.nm, :relative => 0.001)

